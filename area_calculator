#include <stdio.h>
#include <stdlib.h>
#include <math.h>

float sqArea( float length)
{
    float area = length*length;
    return area;
}


float circArea(float rad)
{
    float circarea = 3.142*rad*rad;
    return circarea;
}


float triArea(float base,float height)
{
    float triarea = 0.5*base*height;
    return triarea;
}


float recArea(float length , float breadth)
{
    float recarea = length * breadth;
    return recarea;
}

